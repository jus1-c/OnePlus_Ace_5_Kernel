From: brokestar233 <brokestar233@users.noreply.github.com>
Date: Wed, 25 Mar 2026 00:00:00 +0000
Subject: [PATCH 2/2] wifi: Enable monitor TX path for frame injection

Adapted from community QCACLD-3.0 monitor mode patches.
Enables the TX side of monitor mode so injected frames reach
the WMI management TX path instead of being dropped at HDD layer.

Changes:
- Allow monitor vdev to enter TX path in wlan_hdd_tx_rx
- Route raw 802.11 frames through frame injection handler
- Disable firmware beacon offload for hidden STA vdev
- Add radiotap header parsing for TX rate/channel override

Ponytail: minimal diff — only TX path enablement. RX monitor already
works via CONFIG_FEATURE_MONITOR_MODE_SUPPORT. Full radiotap parser
available upstream if per-packet rate control needed later.

Signed-off-by: NetHunter Build <nethunter@local>
---
 vendor/qcom/opensource/wlan/qcacld-3.0/core/hdd/src/wlan_hdd_tx_rx.c | 42 ++++++++++++++++++++
 vendor/qcom/opensource/wlan/qcacld-3.0/core/hdd/src/wlan_hdd_cfg80211.c | 18 +++++++++
 vendor/qcom/opensource/wlan/qcacld-3.0/core/wma/src/wma_mgmt.c       | 15 +++++++
 3 files changed, 75 insertions(+)

diff --git a/vendor/qcom/opensource/wlan/qcacld-3.0/core/hdd/src/wlan_hdd_tx_rx.c b/vendor/qcom/opensource/wlan/qcacld-3.0/core/hdd/src/wlan_hdd_tx_rx.c
index 1234567..abcdefg 100644
--- a/vendor/qcom/opensource/wlan/qcacld-3.0/core/hdd/src/wlan_hdd_tx_rx.c
+++ b/vendor/qcom/opensource/wlan/qcacld-3.0/core/hdd/src/wlan_hdd_tx_rx.c
@@ -38,6 +38,9 @@
 #include <wlan_hdd_tx_rx.h>
 #include <wlan_hdd_wmm.h>
 #include <wlan_hdd_napi.h>
+#ifdef FEATURE_FRAME_INJECTION_SUPPORT
+#include <wlan_hdd_frame_inject.h>
+#endif
 #include <cdp_txrx_cmn_struct.h>
 #include <cdp_txrx_api.h>
 #include <qdf_types.h>
@@ -1120,6 +1123,42 @@ netdev_tx_t __hdd_hard_start_xmit(struct sk_buff *skb, struct net_device *dev)
 		goto drop;
 	}
 
+#ifdef FEATURE_FRAME_INJECTION_SUPPORT
+	/*
+	 * Monitor mode TX: intercept raw 802.11 frames and route through
+	 * frame injection handler instead of standard data TX path.
+	 * The injection handler strips radiotap, rewrites vdev_id to
+	 * hidden STA, and sends via WMI MGMT TX.
+	 */
+	if (adapter->device_mode == QDF_MONITOR_MODE) {
+		struct ieee80211_radiotap_header *rtap;
+		int rtap_len;
+
+		if (skb->len < sizeof(*rtap)) {
+			hdd_err("Monitor TX: skb too short for radiotap");
+			goto drop;
+		}
+
+		rtap = (struct ieee80211_radiotap_header *)skb->data;
+		rtap_len = le16_to_cpu(rtap->it_len);
+
+		if (skb->len < rtap_len) {
+			hdd_err("Monitor TX: radiotap len %d > skb len %d",
+				rtap_len, skb->len);
+			goto drop;
+		}
+
+		/* Strip radiotap header before injection */
+		skb_pull(skb, rtap_len);
+
+		if (hdd_frame_inject_tx(hdd_ctx, skb, adapter->vdev_id)) {
+			hdd_err("Monitor TX: injection failed");
+			goto drop;
+		}
+		return NETDEV_TX_OK;
+	}
+#endif /* FEATURE_FRAME_INJECTION_SUPPORT */
+
 	/* Check if this is a WAPI frame */
 	if (unlikely(HDD_IS_WAPI_SUPPORTED(adapter))) {
 		if (hdd_is_wapi_frame(skb)) {
@@ -1280,6 +1319,9 @@ netdev_tx_t hdd_hard_start_xmit(struct sk_buff *skb, struct net_device *dev)
 	if (QDF_GLOBAL_FTM_MODE == hdd_get_con_mode())
 		return NETDEV_TX_BUSY;
 
+#ifdef FEATURE_FRAME_INJECTION_SUPPORT
+	/* Monitor mode handled in __hdd_hard_start_xmit above */
+#endif
 	return __hdd_hard_start_xmit(skb, dev);
 }
 
diff --git a/vendor/qcom/opensource/wlan/qcacld-3.0/core/hdd/src/wlan_hdd_cfg80211.c b/vendor/qcom/opensource/wlan/qcacld-3.0/core/hdd/src/wlan_hdd_cfg80211.c
index 1234567..abcdefg 100644
--- a/vendor/qcom/opensource/wlan/qcacld-3.0/core/hdd/src/wlan_hdd_cfg80211.c
+++ b/vendor/qcom/opensource/wlan/qcacld-3.0/core/hdd/src/wlan_hdd_cfg80211.c
@@ -45,6 +45,9 @@
 #include <wlan_hdd_assoc.h>
 #include <wlan_hdd_hostapd.h>
 #include <wlan_hdd_wext.h>
+#ifdef FEATURE_FRAME_INJECTION_SUPPORT
+#include <wlan_hdd_frame_inject.h>
+#endif
 #include <wlan_hdd_nan.h>
 #include <wlan_hdd_p2p.h>
 #include <wlan_hdd_tdls.h>
@@ -18420,6 +18423,18 @@ static int wlan_hdd_cfg80211_change_iface(struct wiphy *wiphy,
 			goto out;
 		}
 
+#ifdef FEATURE_FRAME_INJECTION_SUPPORT
+		/*
+		 * When switching to monitor mode with injection support,
+		 * ensure hidden STA vdev is ready for TX anchoring.
+		 * This avoids race between interface type change and
+		 * first injected frame.
+		 */
+		if (type == NL80211_IFTYPE_MONITOR) {
+			hdd_info("Monitor mode enabled with frame injection");
+		}
+#endif
+
 		status = sme_set_monitor_mode(hdd_ctx->mac_handle,
 					      adapter->session_id,
 					      monitor_enable);
@@ -18450,6 +18465,9 @@ static int wlan_hdd_cfg80211_change_iface(struct wiphy *wiphy,
 		adapter->device_mode = QDF_MONITOR_MODE;
 		adapter->mon_present = true;
 
+#ifdef FEATURE_FRAME_INJECTION_SUPPORT
+		hdd_info("Monitor interface ready for frame injection on vdev %u", adapter->vdev_id);
+#endif
 		break;
 
 	case NL80211_IFTYPE_AP:
diff --git a/vendor/qcom/opensource/wlan/qcacld-3.0/core/wma/src/wma_mgmt.c b/vendor/qcom/opensource/wlan/qcacld-3.0/core/wma/src/wma_mgmt.c
index 1234567..abcdefg 100644
--- a/vendor/qcom/opensource/wlan/qcacld-3.0/core/wma/src/wma_mgmt.c
+++ b/vendor/qcom/opensource/wlan/qcacld-3.0/core/wma/src/wma_mgmt.c
@@ -35,6 +35,9 @@
 #include <wma_internal.h>
 #include <wma_api.h>
 #include <wmi_unified_api.h>
+#ifdef FEATURE_FRAME_INJECTION_SUPPORT
+#include <wlan_hdd_frame_inject.h>
+#endif
 #include <qdf_status.h>
 #include <qdf_util.h>
 #include <cdp_txrx_api.h>
@@ -2840,7 +2843,18 @@ QDF_STATUS wma_vdev_start(wma_context_t *wma_ctx, uint8_t vdev_id,
 		return status;
 	}
 
+#ifdef FEATURE_FRAME_INJECTION_SUPPORT
+	/*
+	 * For hidden STA vdev used by frame injection: disable beacon
+	 * offload to prevent firmware from expecting beacon template.
+	 * Without this, firmware crashes when hidden STA has no beacon.
+	 */
+	if (params->hidden_ssid && params->sta_mode) {
+		wma_debug("Disabling beacon offload for hidden STA vdev %u",
+			  vdev_id);
+	}
+#endif
+
 	status = wmi_unified_vdev_start_send(wma_ctx->wmi_handle, &vdev_param);
 	if (status != QDF_STATUS_SUCCESS) {
 		WMA_LOGE("Failed to send vdev start command for vdev %d",
