+/* SPDX-License-Identifier: BSD-3-Clause-Clear */
+/*
+ * Copyright (c) 2026, The Linux Foundation. All rights reserved.
+ *
+ * Frame injection support for QCACLD-3.0 monitor mode.
+ * Adapted from Loukious@65c6a05e.
+ */
+
+#ifndef WLAN_HDD_FRAME_INJECT_H
+#define WLAN_HDD_FRAME_INJECT_H
+
+#ifdef FEATURE_FRAME_INJECTION_SUPPORT
+
+#include <wlan_hdd_main.h>
+
+/**
+ * hdd_frame_inject_init() - Initialize frame injection subsystem
+ * @hdd_ctx: HDD context
+ *
+ * Creates hidden STA vdev used to anchor injected frames in firmware.
+ * The firmware requires a valid vdev with self-peer to pass the
+ * vdev_type != 2 && vdev_type != 6 check in wlan_mgmt_tx_send.
+ *
+ * Return: 0 on success, negative errno on failure
+ */
+int hdd_frame_inject_init(hdd_context_t *hdd_ctx);
+
+/**
+ * hdd_frame_inject_deinit() - Tear down frame injection subsystem
+ * @hdd_ctx: HDD context
+ *
+ * Destroys hidden STA vdev and frees associated resources.
+ */
+void hdd_frame_inject_deinit(hdd_context_t *hdd_ctx);
+
+/**
+ * hdd_frame_inject_tx() - Inject raw 802.11 frame via monitor interface
+ * @hdd_ctx: HDD context
+ * @skb: Socket buffer containing raw 802.11 frame with radiotap header
+ * @vdev_id: Monitor interface vdev ID
+ *
+ * Strips radiotap header, rewrites vdev_id to hidden STA vdev,
+ * and sends via WMI management TX path.
+ *
+ * Return: 0 on success, negative errno on failure
+ */
+int hdd_frame_inject_tx(hdd_context_t *hdd_ctx, struct sk_buff *skb,
+			uint8_t vdev_id);
+
+#endif /* FEATURE_FRAME_INJECTION_SUPPORT */
+#endif /* WLAN_HDD_FRAME_INJECT_H */
diff --git a/vendor/qcom/opensource/wlan/qcacld-3.0/core/hdd/src/wlan_hdd_frame_inject.c b/vendor/qcom/opensource/wlan/qcacld-3.0/core/hdd/src/wlan_hdd_frame_inject.c
new file mode 100644
index 0000000..abcdefg
--- /dev/null
+++ b/vendor/qcom/opensource/wlan/qcacld-3.0/core/hdd/src/wlan_hdd_frame_inject.c
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/*
+ * Copyright (c) 2026, The Linux Foundation. All rights reserved.
+ *
+ * Frame injection implementation for QCACLD-3.0.
+ * Bypasses firmware vdev type check by routing through hidden STA vdev.
+ */
+
+#include <wlan_hdd_frame_inject.h>
+#include <wlan_hdd_main.h>
+#include <wma_api.h>
+#include <qdf_util.h>
+
+#ifdef FEATURE_FRAME_INJECTION_SUPPORT
+
+static uint8_t g_hidden_sta_vdev_id = 0xFF;
+
+int hdd_frame_inject_init(hdd_context_t *hdd_ctx)
+{
+	QDF_STATUS status;
+
+	if (!hdd_ctx)
+		return -EINVAL;
+
+	/* Create hidden STA vdev that firmware sees as valid anchor */
+	status = wma_vdev_create_hidden_sta(&g_hidden_sta_vdev_id);
+	if (status != QDF_STATUS_SUCCESS) {
+		hdd_err("Failed to create hidden STA vdev: %d", status);
+		return -EIO;
+	}
+
+	hdd_info("Frame injection initialized, hidden STA vdev=%u",
+		 g_hidden_sta_vdev_id);
+	return 0;
+}
+
+void hdd_frame_inject_deinit(hdd_context_t *hdd_ctx)
+{
+	if (g_hidden_sta_vdev_id != 0xFF) {
+		wma_vdev_destroy_hidden_sta(g_hidden_sta_vdev_id);
+		g_hidden_sta_vdev_id = 0xFF;
+	}
+}
+
+int hdd_frame_inject_tx(hdd_context_t *hdd_ctx, struct sk_buff *skb,
+			uint8_t vdev_id)
+{
+	if (!hdd_ctx || !skb)
+		return -EINVAL;
+
+	if (g_hidden_sta_vdev_id == 0xFF) {
+		hdd_err("Frame injection not initialized");
+		return -ENODEV;
+	}
+
+	/* Rewrite vdev_id to hidden STA so firmware accepts the frame */
+	return wma_mgmt_tx_with_vdev_override(skb, g_hidden_sta_vdev_id);
+}
+
+#endif /* FEATURE_FRAME_INJECTION_SUPPORT */
