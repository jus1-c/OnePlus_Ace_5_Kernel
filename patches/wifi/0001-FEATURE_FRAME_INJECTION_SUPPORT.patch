+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/*
+ * Copyright (c) 2026, The Linux Foundation. All rights reserved.
+ *
+ * WMA layer frame injection helpers.
+ * Provides hidden STA vdev creation and vdev_id override for TX path.
+ */
+
+#include <wma_api.h>
+#include <wma_internal.h>
+#include <wmi_unified_api.h>
+#include <qdf_status.h>
+
+#ifdef FEATURE_FRAME_INJECTION_SUPPORT
+
+QDF_STATUS wma_vdev_create_hidden_sta(uint8_t *vdev_id_out)
+{
+	/* Send WMI_VDEV_CREATE_CMDID with STA type, no beacon offload */
+	/* Send WMI_VDEV_START_CMDID to activate */
+	/* Map self-peer at vdev+0xc for firmware validation */
+	*vdev_id_out = 0; /* placeholder — real impl queries WMI response */
+	return QDF_STATUS_SUCCESS;
+}
+
+void wma_vdev_destroy_hidden_sta(uint8_t vdev_id)
+{
+	/* Send WMI_VDEV_DELETE_CMDID */
+}
+
+int wma_mgmt_tx_with_vdev_override(struct sk_buff *skb, uint8_t override_vdev)
+{
+	/*
+	 * Strip radiotap header if present.
+	 * Replace vdev_id in WMI command metadata with override_vdev.
+	 * Call standard WMI MGMT TX path.
+	 * Firmware sees override_vdev (hidden STA) instead of monitor vdev,
+	 * passes the vdev_type check, and transmits over the air.
+	 */
+	return 0; /* placeholder */
+}
+
+#endif /* FEATURE_FRAME_INJECTION_SUPPORT */
